{
  "name": "@edwardseoj/probe",
  "version": "0.1.0",
  "description": "A lightweight CLI for post-deployment sanity checks. Deploy -> Probe -> Know.",
  "type": "module",
  "license": "MIT",
  "author": "Edward Seoj Aquino",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=20"
  },
  "bin": {
